<Window
    x:Class="MTGONotes.App.Windows.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Background="{StaticResource CanvasBrush}" Padding="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <TextBlock
            x:Name="TitleText"
            Grid.Row="0"
            FontSize="24"
            Foreground="{StaticResource InkBrush}"
            Text="MTGO Opponent Notes" />
        <StackPanel Grid.Row="1" Margin="0,16,0,12" Spacing="8">
            <TextBlock x:Name="PhaseText" Foreground="{StaticResource MutedBrush}" />
            <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBox
                    x:Name="HandleBox"
                    Width="280"
                    PlaceholderText="Opponent handle" />
                <Button x:Name="ConfirmButton" Click="OnConfirmClick" Content="Confirm opponent" />
                <Button x:Name="FinishButton" Click="OnFinishClick" Content="Finish encounter" />
            </StackPanel>
            <TextBlock
                x:Name="StatusText"
                Foreground="{StaticResource MutedBrush}"
                TextWrapping="Wrap" />
        </StackPanel>
        <ListView
            x:Name="NotesList"
            Grid.Row="2"
            Background="{StaticResource SurfaceSoftBrush}" />
    </Grid>
</Window>
