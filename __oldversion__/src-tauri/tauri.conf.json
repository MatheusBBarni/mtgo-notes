{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MTGO Opponent Notes",
  "version": "0.1.0",
  "identifier": "dev.mtgonotes.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "MTGO Opponent Notes",
        "url": "index.html",
        "create": false,
        "width": 1200,
        "height": 800,
        "minWidth": 960,
        "minHeight": 680,
        "visible": true,
        "focus": true,
        "resizable": true,
        "decorations": true
      },
      {
        "label": "overlay",
        "title": "Opponent overlay",
        "url": "overlay.html",
        "create": false,
        "width": 360,
        "height": 220,
        "visible": false,
        "focus": false,
        "focusable": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": true,
        "decorations": false
      },
      {
        "label": "capture",
        "title": "Quick capture",
        "url": "capture.html",
        "create": false,
        "width": 420,
        "height": 160,
        "visible": false,
        "focus": false,
        "focusable": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "decorations": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' asset: data:; style-src 'self' 'unsafe-inline'; font-src 'self'; object-src 'none'; frame-src 'none'; base-uri 'none'; form-action 'none'",
      "freezePrototype": true,
      "assetProtocol": {
        "enable": false
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["../assets/icons/mtgo-notes.ico"],
    "resources": [
      "../THIRD_PARTY_NOTICES.md",
      "../assets/fonts/Inter-OFL-1.1.txt",
      "resources/classifier/*",
      "resources/detection/*"
    ],
    "copyright": "Copyright © 2026 MTGO Opponent Notes contributors",
    "shortDescription": "Private, local-first MTGO opponent notes",
    "longDescription": "A private Windows companion for capturing and recalling personal MTGO opponent observations.",
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "nsis": {
        "installerIcon": "../assets/icons/mtgo-notes.ico",
        "installMode": "currentUser"
      }
    }
  }
}
