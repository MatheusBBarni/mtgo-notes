<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
            <Color x:Key="CanvasColor">#FFFFFF</Color>
            <Color x:Key="InkColor">#181D26</Color>
            <Color x:Key="BodyColor">#333840</Color>
            <Color x:Key="MutedColor">#41454D</Color>
            <Color x:Key="HairlineColor">#DDDDDD</Color>
            <Color x:Key="SurfaceSoftColor">#F8FAFC</Color>
            <Color x:Key="FocusColor">#254FAD</Color>
            <SolidColorBrush x:Key="CanvasBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="InkBrush" Color="#181D26" />
            <SolidColorBrush x:Key="BodyBrush" Color="#333840" />
            <SolidColorBrush x:Key="MutedBrush" Color="#41454D" />
            <SolidColorBrush x:Key="HairlineBrush" Color="#DDDDDD" />
            <SolidColorBrush x:Key="SurfaceSoftBrush" Color="#F8FAFC" />
            <SolidColorBrush x:Key="FocusBrush" Color="#254FAD" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
            <Color x:Key="CanvasColor">#181D26</Color>
            <Color x:Key="InkColor">#F5F6F7</Color>
            <Color x:Key="BodyColor">#D0D4DB</Color>
            <Color x:Key="MutedColor">#B4B8C0</Color>
            <Color x:Key="HairlineColor">#3A404A</Color>
            <Color x:Key="SurfaceSoftColor">#1D1F25</Color>
            <Color x:Key="FocusColor">#458FFF</Color>
            <SolidColorBrush x:Key="CanvasBrush" Color="#181D26" />
            <SolidColorBrush x:Key="InkBrush" Color="#F5F6F7" />
            <SolidColorBrush x:Key="BodyBrush" Color="#D0D4DB" />
            <SolidColorBrush x:Key="MutedBrush" Color="#B4B8C0" />
            <SolidColorBrush x:Key="HairlineBrush" Color="#3A404A" />
            <SolidColorBrush x:Key="SurfaceSoftBrush" Color="#1D1F25" />
            <SolidColorBrush x:Key="FocusBrush" Color="#458FFF" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="HighContrast">
            <SolidColorBrush x:Key="CanvasBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="InkBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="BodyBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="MutedBrush" Color="{ThemeResource SystemColorGrayTextColor}" />
            <SolidColorBrush x:Key="HairlineBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="SurfaceSoftBrush" Color="{ThemeResource SystemColorButtonFaceColor}" />
            <SolidColorBrush x:Key="FocusBrush" Color="{ThemeResource SystemColorHighlightColor}" />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>
    <x:Double x:Key="Space100">4</x:Double>
    <x:Double x:Key="Space200">8</x:Double>
    <x:Double x:Key="Space300">12</x:Double>
    <x:Double x:Key="Space400">16</x:Double>
    <CornerRadius x:Key="ControlRadius">6</CornerRadius>
    <CornerRadius x:Key="CardRadius">10</CornerRadius>
    <CornerRadius x:Key="PanelRadius">12</CornerRadius>
</ResourceDictionary>
