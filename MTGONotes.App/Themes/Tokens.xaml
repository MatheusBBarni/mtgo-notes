<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Color x:Key="CanvasColor">#FFFFFF</Color>
    <Color x:Key="InkColor">#181D26</Color>
    <Color x:Key="BodyColor">#333840</Color>
    <Color x:Key="MutedColor">#41454D</Color>
    <Color x:Key="HairlineColor">#DDDDDD</Color>
    <Color x:Key="SurfaceSoftColor">#F8FAFC</Color>
    <Color x:Key="FocusColor">#254FAD</Color>
    <SolidColorBrush x:Key="CanvasBrush" Color="{StaticResource CanvasColor}" />
    <SolidColorBrush x:Key="InkBrush" Color="{StaticResource InkColor}" />
    <SolidColorBrush x:Key="BodyBrush" Color="{StaticResource BodyColor}" />
    <SolidColorBrush x:Key="MutedBrush" Color="{StaticResource MutedColor}" />
    <SolidColorBrush x:Key="HairlineBrush" Color="{StaticResource HairlineColor}" />
    <SolidColorBrush x:Key="SurfaceSoftBrush" Color="{StaticResource SurfaceSoftColor}" />
    <SolidColorBrush x:Key="FocusBrush" Color="{StaticResource FocusColor}" />
    <x:Double x:Key="Space100">4</x:Double>
    <x:Double x:Key="Space200">8</x:Double>
    <x:Double x:Key="Space300">12</x:Double>
    <x:Double x:Key="Space400">16</x:Double>
    <CornerRadius x:Key="ControlRadius">6</CornerRadius>
    <CornerRadius x:Key="CardRadius">10</CornerRadius>
    <CornerRadius x:Key="PanelRadius">12</CornerRadius>
</ResourceDictionary>
