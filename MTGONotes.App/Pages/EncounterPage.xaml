<Page
    x:Class="MTGONotes.App.Pages.EncounterPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:helpers="using:MTGONotes.App.Helpers"
    xmlns:vm="using:MTGONotes.App.ViewModels"
    x:DefaultBindMode="OneWay">
    <Grid x:Name="PageRoot" Padding="24">
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="WidthStates">
                <VisualState x:Name="Wide">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="1008" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="PageRoot.Padding" Value="24" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Medium">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="640" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="PageRoot.Padding" Value="16" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Narrow">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="0" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="PageRoot.Padding" Value="12" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <StackPanel Spacing="4">
            <TextBlock
                x:Name="PhaseHeading"
                AutomationProperties.AutomationId="LblPhase"
                Style="{StaticResource TitleTextBlockStyle}"
                Text="{x:Bind Vm.PhaseTitle}"
                TextWrapping="Wrap" />
            <TextBlock
                x:Name="LiveStatusText"
                AutomationProperties.AutomationId="LblLiveStatus"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Style="{StaticResource CaptionTextBlockStyle}"
                Text="{x:Bind Vm.LiveStatus}"
                TextWrapping="Wrap" />
        </StackPanel>
        <InfoBar
            x:Name="EncounterStatus"
            Grid.Row="1"
            Margin="0,12,0,0"
            AutomationProperties.AutomationId="InfEncounter"
            IsClosable="True"
            IsOpen="{x:Bind Vm.IsStatusOpen, Mode=TwoWay}"
            Message="{x:Bind Vm.StatusMessage}"
            Severity="{x:Bind helpers:XamlConverters.StatusSeverity(Vm.IsStatusError)}" />
        <TextBox
            x:Name="HandleBox"
            Grid.Row="2"
            Margin="0,16,0,0"
            AutomationProperties.AutomationId="TxtOpponentHandle"
            Header="Opponent handle"
            KeyDown="OnHandleKeyDown"
            PlaceholderText="Enter the exact MTGO nickname"
            Text="{x:Bind Vm.Handle, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
        <CommandBar
            Grid.Row="3"
            Margin="0,8,0,8"
            Background="Transparent"
            DefaultLabelPosition="Right"
            OverflowButtonVisibility="Auto">
            <AppBarButton
                AutomationProperties.AutomationId="BtnConfirmOpponent"
                Command="{x:Bind Vm.ConfirmOpponentCommand}"
                Icon="Accept"
                Label="Confirm opponent" />
            <AppBarButton
                AutomationProperties.AutomationId="BtnFinishEncounter"
                Click="OnFinishClick"
                IsEnabled="{x:Bind Vm.HasConfirmedOpponent}"
                Label="Finish encounter">
                <AppBarButton.Icon>
                    <FontIcon FontFamily="{ThemeResource SymbolThemeFontFamily}" Glyph="&#xE8FB;" />
                </AppBarButton.Icon>
            </AppBarButton>
            <AppBarSeparator />
            <AppBarButton
                AutomationProperties.AutomationId="BtnPauseLive"
                Command="{x:Bind Vm.ToggleLivePauseCommand}"
                Label="{x:Bind Vm.PauseLabel}">
                <AppBarButton.Icon>
                    <FontIcon FontFamily="{ThemeResource SymbolThemeFontFamily}" Glyph="&#xE769;" />
                </AppBarButton.Icon>
            </AppBarButton>
        </CommandBar>
        <Grid Grid.Row="4">
            <ListView
                x:Name="NotesList"
                AutomationProperties.AutomationId="LstNotes"
                AutomationProperties.Name="Current observations"
                ItemsSource="{x:Bind Vm.Notes}"
                SelectionMode="None"
                Visibility="{x:Bind helpers:XamlConverters.VisibleWhen(Vm.HasNotes)}">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="vm:ObservationItem">
                        <TextBlock
                            Padding="0,8"
                            Style="{StaticResource BodyTextBlockStyle}"
                            Text="{x:Bind Text}"
                            TextWrapping="Wrap" />
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
            <StackPanel
                MaxWidth="480"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Spacing="8"
                Visibility="{x:Bind helpers:XamlConverters.CollapsedWhen(Vm.HasNotes)}">
                <TextBlock
                    AutomationProperties.AutomationId="LblNotesEmpty"
                    Style="{StaticResource SubtitleTextBlockStyle}"
                    Text="No observations yet" />
                <TextBlock
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Style="{StaticResource BodyTextBlockStyle}"
                    Text="Confirm an opponent, then capture a note with Ctrl+Shift+N."
                    TextWrapping="Wrap" />
            </StackPanel>
        </Grid>
    </Grid>
</Page>
