<Page
    x:Class="MTGONotes.App.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:helpers="using:MTGONotes.App.Helpers"
    x:DefaultBindMode="OneWay">
    <ScrollViewer>
        <Grid x:Name="PageRoot" Padding="24">
            <VisualStateManager.VisualStateGroups>
                <VisualStateGroup x:Name="WidthStates">
                    <VisualState x:Name="Wide">
                        <VisualState.StateTriggers>
                            <AdaptiveTrigger MinWindowWidth="1008" />
                        </VisualState.StateTriggers>
                        <VisualState.Setters>
                            <Setter Target="PageRoot.Padding" Value="24" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Medium">
                        <VisualState.StateTriggers>
                            <AdaptiveTrigger MinWindowWidth="640" />
                        </VisualState.StateTriggers>
                        <VisualState.Setters>
                            <Setter Target="PageRoot.Padding" Value="16" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Narrow">
                        <VisualState.StateTriggers>
                            <AdaptiveTrigger MinWindowWidth="0" />
                        </VisualState.StateTriggers>
                        <VisualState.Setters>
                            <Setter Target="PageRoot.Padding" Value="12" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>
            <StackPanel MaxWidth="720" Spacing="20">
                <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="Settings" />
                <InfoBar
                    x:Name="SettingsStatus"
                    AutomationProperties.AutomationId="InfSettings"
                    IsClosable="True"
                    IsOpen="{x:Bind Vm.IsStatusOpen, Mode=TwoWay}"
                    Message="{x:Bind Vm.StatusMessage}"
                    Severity="{x:Bind helpers:XamlConverters.StatusSeverity(Vm.IsStatusError)}" />
                <StackPanel Spacing="12">
                    <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="Live attach" />
                    <TextBlock
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{StaticResource BodyTextBlockStyle}"
                        Text="Live attach reads the already-logged-in MTGO process. It is unofficial, can be paused, and never logs on or writes to MTGO."
                        TextWrapping="Wrap" />
                    <ToggleSwitch
                        AutomationProperties.AutomationId="TglLiveAttach"
                        Header="Enable live attach"
                        IsOn="{x:Bind Vm.LiveAttachEnabled, Mode=TwoWay}"
                        OffContent="Off"
                        OnContent="On" />
                    <ToggleSwitch
                        AutomationProperties.AutomationId="TglDeckConsent"
                        Header="Allow official MTGO deck lookup"
                        IsOn="{x:Bind Vm.OfficialDeckConsent, Mode=TwoWay}"
                        OffContent="Off"
                        OnContent="On" />
                    <Button
                        AutomationProperties.AutomationId="BtnOpenOfficialDecks"
                        Command="{x:Bind Vm.OpenOfficialDecksCommand}"
                        Content="Open official MTGO decklists" />
                </StackPanel>
                <StackPanel Spacing="12">
                    <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="Companion chrome" />
                    <ToggleSwitch
                        AutomationProperties.AutomationId="TglOverlay"
                        Header="Show opponent overlay"
                        IsOn="{x:Bind Vm.OverlayEnabled, Mode=TwoWay}"
                        OffContent="Off"
                        OnContent="On" />
                    <ToggleSwitch
                        AutomationProperties.AutomationId="TglTray"
                        Header="Keep a tray icon"
                        IsOn="{x:Bind Vm.TrayEnabled, Mode=TwoWay}"
                        OffContent="Off"
                        OnContent="On" />
                    <ToggleSwitch
                        AutomationProperties.AutomationId="TglAutostart"
                        Header="Launch with Windows"
                        IsOn="{x:Bind Vm.LaunchWithWindows, Mode=TwoWay}"
                        OffContent="Off"
                        OnContent="On" />
                </StackPanel>
                <StackPanel Spacing="12">
                    <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="Appearance" />
                    <RadioButtons
                        x:Name="ThemeBox"
                        AutomationProperties.AutomationId="RbnTheme"
                        Header="Theme"
                        MaxColumns="3"
                        SelectedIndex="{x:Bind Vm.ThemeIndex, Mode=TwoWay}">
                        <x:String>Match Windows</x:String>
                        <x:String>Light</x:String>
                        <x:String>Dark</x:String>
                    </RadioButtons>
                </StackPanel>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>
