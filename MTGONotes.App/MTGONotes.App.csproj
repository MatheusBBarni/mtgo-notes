<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>MTGONotes.App</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <!-- Redirect PRI generation to WinAppSDK tasks so `dotnet build` works without VS AppxPackage. -->
    <EnableMsixTooling>true</EnableMsixTooling>
    <Platforms>x64</Platforms>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ApplicationIcon>Assets/mtgo-notes.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <Content Update="Assets/**">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" />
    <PackageReference Include="CommunityToolkit.Mvvm">
      <Aliases>ToolkitMvvm</Aliases>
    </PackageReference>
    <PackageReference Include="MTGOSDK" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\MTGONotes.Core\MTGONotes.Core.csproj" />
    <ProjectReference Include="..\MTGONotes.Data\MTGONotes.Data.csproj" />
    <ProjectReference Include="..\MTGONotes.Live\MTGONotes.Live.csproj" />
  </ItemGroup>
</Project>
