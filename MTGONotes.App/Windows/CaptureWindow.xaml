<Window
    x:Class="MTGONotes.App.Windows.CaptureWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Background="{StaticResource CanvasBrush}" Padding="12">
        <StackPanel Spacing="8">
            <TextBlock Foreground="{StaticResource InkBrush}" Text="Quick capture" />
            <TextBox
                x:Name="NoteBox"
                KeyDown="OnNoteKeyDown"
                PlaceholderText="Observation" />
            <TextBlock
                x:Name="ErrorText"
                Foreground="{StaticResource MutedBrush}"
                TextWrapping="Wrap" />
        </StackPanel>
    </Border>
</Window>
