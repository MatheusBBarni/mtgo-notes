<Window
    x:Class="MTGONotes.App.Windows.CaptureWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Background="{ThemeResource CanvasBrush}" Padding="16">
        <StackPanel Spacing="12">
            <TextBlock
                AutomationProperties.AutomationId="LblQuickCapture"
                Style="{StaticResource SubtitleTextBlockStyle}"
                Text="Quick capture" />
            <TextBox
                x:Name="NoteBox"
                AutomationProperties.AutomationId="TxtCaptureNote"
                Header="Observation"
                KeyDown="OnNoteKeyDown"
                PlaceholderText="What did you notice?" />
            <InfoBar
                x:Name="CaptureStatus"
                AutomationProperties.AutomationId="InfCapture"
                IsClosable="False"
                IsOpen="False"
                Severity="Error" />
        </StackPanel>
    </Border>
</Window>
