<Window
    x:Class="MTGONotes.App.Windows.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>
    <Grid x:Name="RootGrid" SizeChanged="OnRootSizeChanged">
        <Grid.KeyboardAccelerators>
            <KeyboardAccelerator Key="Number1" Modifiers="Control" Invoked="OnGoEncounter" />
            <KeyboardAccelerator Key="Number2" Modifiers="Control" Invoked="OnGoHistory" />
            <KeyboardAccelerator Key="Number3" Modifiers="Control" Invoked="OnGoSettings" />
        </Grid.KeyboardAccelerators>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <TitleBar
            x:Name="AppTitleBar"
            Title="MTGO Opponent Notes"
            IsBackButtonVisible="False"
            IsPaneToggleButtonVisible="True"
            PaneToggleRequested="OnPaneToggleRequested"
            Subtitle="{x:Bind Vm.LiveStatus, Mode=OneWay}">
            <TitleBar.IconSource>
                <ImageIconSource x:Name="TitleBarIcon" />
            </TitleBar.IconSource>
        </TitleBar>
        <NavigationView
            x:Name="RootNav"
            Grid.Row="1"
            IsBackButtonVisible="Collapsed"
            IsPaneToggleButtonVisible="False"
            IsSettingsVisible="False"
            IsTitleBarAutoPaddingEnabled="False"
            OpenPaneLength="260"
            PaneDisplayMode="Left"
            SelectionChanged="OnNavSelectionChanged">
            <NavigationView.MenuItems>
                <NavigationViewItem
                    x:Name="EncounterNavItem"
                    AccessKey="E"
                    AutomationProperties.AutomationId="NavEncounter"
                    Content="Encounter"
                    Icon="Contact"
                    IsSelected="True"
                    Tag="encounter" />
                <NavigationViewItem
                    x:Name="HistoryNavItem"
                    AccessKey="H"
                    AutomationProperties.AutomationId="NavHistory"
                    Content="History"
                    Icon="Clock"
                    Tag="history" />
            </NavigationView.MenuItems>
            <NavigationView.FooterMenuItems>
                <NavigationViewItem
                    x:Name="SettingsNavItem"
                    AccessKey="S"
                    AutomationProperties.AutomationId="NavSettings"
                    Content="Settings"
                    Icon="Setting"
                    Tag="settings" />
            </NavigationView.FooterMenuItems>
            <Frame x:Name="ContentFrame" />
        </NavigationView>
    </Grid>
</Window>
