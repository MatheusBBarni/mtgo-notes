<Window
    x:Class="MTGONotes.App.Windows.OverlayWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border
        Background="{ThemeResource CanvasBrush}"
        BorderBrush="{ThemeResource HairlineBrush}"
        BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid
                x:Name="DragBar"
                Background="{ThemeResource SurfaceSoftBrush}"
                Padding="10,6"
                PointerPressed="OnDragBarPressed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Image
                    x:Name="BrandImage"
                    Width="18"
                    Height="18"
                    Margin="0,0,8,0"
                    VerticalAlignment="Center"
                    AutomationProperties.AccessibilityView="Raw" />
                <TextBlock
                    x:Name="PhaseText"
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    AutomationProperties.AutomationId="LblOverlayPhase"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    FontWeight="SemiBold"
                    Foreground="{ThemeResource InkBrush}"
                    Text="Idle"
                    TextTrimming="CharacterEllipsis" />
                <StackPanel
                    Grid.Column="2"
                    Margin="8,0,0,0"
                    Orientation="Horizontal"
                    Spacing="2">
                    <Button
                        x:Name="MinimizeButton"
                        Width="32"
                        Height="32"
                        Padding="0"
                        AutomationProperties.AutomationId="BtnMinimizeOverlay"
                        AutomationProperties.Name="Minimize overlay"
                        Background="Transparent"
                        BorderThickness="0"
                        Click="OnMinimizeClick"
                        ToolTipService.ToolTip="Minimize">
                        <FontIcon
                            x:Name="MinimizeIcon"
                            FontFamily="{ThemeResource SymbolThemeFontFamily}"
                            FontSize="11"
                            Glyph="&#xE921;" />
                    </Button>
                    <Button
                        x:Name="HideButton"
                        Width="32"
                        Height="32"
                        Padding="0"
                        AutomationProperties.AutomationId="BtnHideOverlay"
                        AutomationProperties.Name="Hide overlay"
                        Background="Transparent"
                        BorderThickness="0"
                        Click="OnHideClick"
                        ToolTipService.ToolTip="Hide">
                        <FontIcon
                            FontFamily="{ThemeResource SymbolThemeFontFamily}"
                            FontSize="11"
                            Glyph="&#xE8BB;" />
                    </Button>
                </StackPanel>
            </Grid>
            <StackPanel
                x:Name="BodyPanel"
                Grid.Row="1"
                Padding="12"
                Spacing="8">
                <TextBlock
                    x:Name="CandidateText"
                    AutomationProperties.AutomationId="LblOverlayCandidate"
                    Foreground="{ThemeResource BodyBrush}"
                    Style="{StaticResource BodyTextBlockStyle}"
                    TextWrapping="Wrap"
                    Visibility="Collapsed" />
                <Button
                    x:Name="ConfirmButton"
                    AutomationProperties.AutomationId="BtnConfirmCandidate"
                    Click="OnConfirmClick"
                    Content="Confirm opponent"
                    Visibility="Collapsed" />
                <ListView
                    x:Name="NotesList"
                    MaxHeight="88"
                    AutomationProperties.AutomationId="LstOverlayNotes"
                    AutomationProperties.Name="Current observations"
                    SelectionMode="None">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="x:String">
                            <TextBlock
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Text="{x:Bind}"
                                TextWrapping="Wrap" />
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
                <TextBlock
                    x:Name="HintText"
                    AutomationProperties.AutomationId="LblOverlayHint"
                    Foreground="{ThemeResource MutedBrush}"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Text="Ready for a confirmed opponent."
                    TextWrapping="Wrap" />
                <TextBlock
                    x:Name="RestrictionText"
                    AutomationProperties.AutomationId="LblOverlayRestriction"
                    Foreground="{ThemeResource MutedBrush}"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Text="History hidden during possible gameplay."
                    TextWrapping="Wrap"
                    Visibility="Collapsed" />
                <Button
                    x:Name="CaptureButton"
                    HorizontalAlignment="Left"
                    AutomationProperties.AutomationId="BtnCaptureNote"
                    Click="OnCaptureClick"
                    Content="Capture note" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
