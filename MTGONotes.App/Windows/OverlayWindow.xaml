<Window
    x:Class="MTGONotes.App.Windows.OverlayWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border
        Background="{StaticResource CanvasBrush}"
        BorderBrush="{StaticResource HairlineBrush}"
        BorderThickness="1"
        CornerRadius="{StaticResource PanelRadius}"
        Padding="12">
        <StackPanel Spacing="8">
            <TextBlock
                x:Name="PhaseText"
                FontSize="14"
                Foreground="{StaticResource InkBrush}"
                Text="idle" />
            <TextBlock
                x:Name="CandidateText"
                Foreground="{StaticResource MutedBrush}"
                TextWrapping="Wrap"
                Visibility="Collapsed" />
            <Button
                x:Name="ConfirmButton"
                Click="OnConfirmClick"
                Content="Confirm opponent"
                Visibility="Collapsed" />
            <ItemsControl x:Name="NotesList" />
            <Button x:Name="ExpandButton" Click="OnExpandClick" Content="Expand overlay" />
            <TextBlock
                FontSize="12"
                Foreground="{StaticResource MutedBrush}"
                Text="History hidden during possible gameplay." />
        </StackPanel>
    </Border>
</Window>
