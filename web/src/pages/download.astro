---
import DownloadCta from "../components/DownloadCta.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { copy } from "../content/copy";
---

<BaseLayout title="Download — MTGO Opponent Notes">
  <article class="page">
    <h1>Download</h1>
    <DownloadCta />
    <p id="download-version" class="version" aria-live="polite"></p>
    <p>{copy.requirements}</p>
    <p>{copy.liveAttachHint}</p>
    <p>
      <a href={copy.githubReleasesHref}>{copy.githubReleasesLabel}</a>
    </p>
  </article>
</BaseLayout>
