---
import BaseLayout from "../layouts/BaseLayout.astro";
import { copy } from "../content/copy";
---

<BaseLayout title="How it works — MTGO Opponent Notes">
  <article class="page">
    <h1>How it works</h1>
    <ol class="stack">
      <li>{copy.howItWorks.notebook}</li>
      <li>{copy.howItWorks.confirm}</li>
      <li>{copy.howItWorks.overlay}</li>
      <li>{copy.howItWorks.hiddenHistory}</li>
      <li>{copy.howItWorks.publicPreview}</li>
    </ol>
    <figure class="screenshot-placeholder">
      <figcaption>{copy.howItWorks.screenshotCaption}</figcaption>
    </figure>
  </article>
</BaseLayout>
