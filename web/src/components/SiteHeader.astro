---
import BrandMark from "./BrandMark.astro";
import ThemeToggle from "./ThemeToggle.astro";
import { pageHref } from "../lib/site";

const current = Astro.url.pathname.replace(/\/$/, "") || pageHref("");
const links = [
  { href: pageHref(""), label: "Home" },
  { href: pageHref("download"), label: "Download" },
  { href: pageHref("how-it-works"), label: "How it works" },
  { href: pageHref("live-attach"), label: "Live attach" },
  { href: pageHref("privacy"), label: "Privacy" },
] as const;
---

<header class="site-header">
  <a class="brand" href={pageHref("")}>
    <BrandMark />
    <span>MTGO Opponent Notes</span>
  </a>
  <div class="header-tools">
    <nav class="site-nav" aria-label="Primary">
      {
        links.map((link) => (
          <a
            href={link.href}
            aria-current={current === link.href ? "page" : undefined}
          >
            {link.label}
          </a>
        ))
      }
    </nav>
    <ThemeToggle />
  </div>
</header>
