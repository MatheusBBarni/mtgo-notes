{
  "name": "mtgo-opponent-notes",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@10.9.8",
  "engines": {
    "node": "22.23.1"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:rust": "cargo build --manifest-path src-tauri/Cargo.toml",
    "build:windows": "tauri build --target x86_64-pc-windows-msvc --bundles nsis",
    "tauri": "tauri",
    "format": "prettier --check . && cargo fmt --manifest-path src-tauri/Cargo.toml --all --check",
    "format:write": "prettier --write . && cargo fmt --manifest-path src-tauri/Cargo.toml --all",
    "lint": "npm run lint:frontend && npm run lint:rust",
    "lint:frontend": "eslint . --max-warnings 0",
    "lint:rust": "cargo clippy --manifest-path src-tauri/Cargo.toml --all-targets -- -D warnings",
    "lint:capabilities": "tsx scripts/lint-capabilities.ts",
    "typecheck": "tsc --noEmit",
    "test": "npm run test:unit && npm run test:integration && npm run test:rust",
    "test:unit": "vitest run --config vitest.unit.config.ts",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml",
    "test:windows": "cargo test --manifest-path src-tauri/Cargo.toml --target x86_64-pc-windows-msvc",
    "verify": "npm run format && npm run lint && npm run typecheck && npm run lint:capabilities && npm test && npm run build && npm run build:rust"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@heroui/react": "3.2.2",
    "@heroui/styles": "3.2.2",
    "@tauri-apps/api": "2.11.1",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@tailwindcss/vite": "4.3.3",
    "@tauri-apps/cli": "2.11.4",
    "@testing-library/jest-dom": "7.0.0",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "26.1.2",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.4",
    "axe-core": "4.12.1",
    "eslint": "10.8.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.3",
    "globals": "17.8.0",
    "jsdom": "30.0.0",
    "prettier": "3.9.6",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.65.0",
    "vite": "8.1.5",
    "vitest": "4.1.10"
  }
}
