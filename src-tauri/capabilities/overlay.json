{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "overlay-window",
  "description": "Policy-filtered commands and replacement events for the compact overlay.",
  "windows": ["overlay"],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "core:window:allow-hide",
    "allow-bootstrap",
    "allow-pause-detection",
    "allow-confirm-opponent",
    "allow-correct-phase",
    "allow-open-capture",
    "allow-finish-encounter",
    "allow-undo-transition",
    "allow-set-overlay-interaction"
  ]
}
